# /etc/heyi-eval-v10/env — copied to /etc/ by scripts/bootstrap_nv8.sh on first run.
#
# All settings here OVERRIDE the defaults in orchestrator/config.py. The
# defaults already match the nv8 production layout, so a fresh install
# usually only needs to fill in HEYI_ENGINE_API_KEY if heyi_engine requires
# one. Everything else is opt-in.

# ── data paths ──────────────────────────────────────────────────────────────
# HEYI_EVAL_DATA=/home/ai/heyi-eval-data
# HEYI_EVAL_BACKUPS=/home/ai/heyi-eval-backups
# HEYI_EVAL_MODEL_CACHE=/DATA/Model/_eval-cache

# ── LLM provider (2026-05 Zhipu migration) ──────────────────────────────────
# DEFAULT provider is now Zhipu's OpenAI-compatible GLM-5.1 cloud API. No
# local LLM weights are hosted on the GPU box anymore — curator, showcase,
# deploy_repair, llm_judge AND the project/skill agent runs all use the
# cloud brain. Fill in ZHIPU_API_KEY (the only required field):
HEYI_EVAL_JUDGE_PROVIDER=zhipu
ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-5.1                       # default model id when JUDGE_MODEL unset
# HEYI_EVAL_JUDGE_MODEL=glm-5.1             # overrides the per-provider default
# HEYI_EVAL_AGENT_MODEL=zhipu-glm,glm-5.1   # ccr Router spec for the agent route
#
# ── fallback providers (opt-in) ─────────────────────────────────────────────
# yunwu.ai (MiniMax-M2.7) — set HEYI_EVAL_JUDGE_PROVIDER=yunwu to use:
#   YUNWU_BASE_URL=https://yunwu.ai/v1
#   YUNWU_GENERAL_KEY=sk-...   (or YUNWU_KEY_2 / YUNWU_GPT_KEY)
#   HEYI_EVAL_JUDGE_MODEL=MiniMax-M2.7
# Local vLLM (any other provider value) — historical :10814 path:
#   HEYI_ENGINE_URL=http://127.0.0.1:10814
#   HEYI_ENGINE_API_KEY=

# ── HF mirror ───────────────────────────────────────────────────────────────
# HF_ENDPOINT=https://hf-mirror.com

# ── orchestrator stage timeouts (seconds) ───────────────────────────────────
# HEYI_EVAL_DEPLOY_TIMEOUT=600
# HEYI_EVAL_CAPABILITY_TIMEOUT=900
# HEYI_EVAL_SHOWCASE_TIMEOUT=3600
# HEYI_EVAL_CLEANUP_TIMEOUT=300

# ── orchestrator main-loop pacing ───────────────────────────────────────────
# HEYI_HEARTBEAT_INTERVAL=14400          # 4h between desktop heartbeats
# HEYI_ENGINE_REMIND_INTERVAL=3600       # 1h between "still paused" reminders

# ── panel ───────────────────────────────────────────────────────────────────
# HEYI_PANEL_HOST=0.0.0.0
# HEYI_PANEL_PORT=8090
