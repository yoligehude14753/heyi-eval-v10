# /etc/heyi-eval-v10/env — copied to /etc/ by scripts/bootstrap_nv8.sh on first run.
#
# All settings here OVERRIDE the defaults in orchestrator/config.py. The
# defaults already match the nv8 production layout, so a fresh install
# usually only needs to fill in HEYI_ENGINE_API_KEY if heyi_engine requires
# one. Everything else is opt-in.

# ── data paths ──────────────────────────────────────────────────────────────
# HEYI_EVAL_DATA=/home/ai/heyi-eval-data
# HEYI_EVAL_BACKUPS=/home/ai/heyi-eval-backups
# HEYI_EVAL_MODEL_CACHE=/DATA/Model/_eval-cache

# ── heyi_engine (production LLM) ────────────────────────────────────────────
# Production endpoint runs at :10814 on the same host. If the engine requires
# an API key, set it here. Leave commented to use no auth header.
# HEYI_ENGINE_URL=http://127.0.0.1:10814
# HEYI_ENGINE_API_KEY=

# ── HF mirror ───────────────────────────────────────────────────────────────
# HF_ENDPOINT=https://hf-mirror.com

# ── orchestrator stage timeouts (seconds) ───────────────────────────────────
# HEYI_EVAL_DEPLOY_TIMEOUT=600
# HEYI_EVAL_CAPABILITY_TIMEOUT=900
# HEYI_EVAL_SHOWCASE_TIMEOUT=3600
# HEYI_EVAL_CLEANUP_TIMEOUT=300

# ── orchestrator main-loop pacing ───────────────────────────────────────────
# HEYI_HEARTBEAT_INTERVAL=14400          # 4h between desktop heartbeats
# HEYI_ENGINE_REMIND_INTERVAL=3600       # 1h between "still paused" reminders

# ── panel ───────────────────────────────────────────────────────────────────
# HEYI_PANEL_HOST=0.0.0.0
# HEYI_PANEL_PORT=8090
