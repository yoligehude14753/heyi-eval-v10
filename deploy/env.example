# /etc/heyi-eval-v10/env — copied to /etc/ by scripts/bootstrap_nv8.sh on first run.
#
# All settings here OVERRIDE the defaults in orchestrator/config.py. The
# defaults already match the nv8 production layout, so a fresh install
# usually only needs to fill in HEYI_ENGINE_API_KEY if heyi_engine requires
# one. Everything else is opt-in.

# ── data paths ──────────────────────────────────────────────────────────────
# HEYI_EVAL_DATA=/home/ai/heyi-eval-data
# HEYI_EVAL_BACKUPS=/home/ai/heyi-eval-backups
# HEYI_EVAL_MODEL_CACHE=/DATA/Model/_eval-cache

# ── storage control ─────────────────────────────────────────────────────────
# Eval-cache LRU quota (GB). Default in code is 200; tighten it now that
# the LLM brain is cloud (Zhipu) and project/skill lanes are GPU-free —
# only model_lane downloads HF weights, and it's no longer in the daily
# auto-loop. 80-120 GB is plenty for occasional manual model runs.
HEYI_EVAL_CACHE_QUOTA_GB=100

# ── local radar (discovery source) ──────────────────────────────────────────
# Where the co-located radar service serves GET /api/items. Used by
# `discover.main radar-local-once` (heyi-eval-radar-local.timer).
RADAR_BASE_URL=http://127.0.0.1:7090

# ── LLM provider ────────────────────────────────────────────────────────────
# DEFAULT provider is yunwu.ai's OpenAI-compatible MiniMax-M2.7 cloud API
# (the provider with a working key). No local LLM weights are hosted on the
# GPU box — curator, showcase, deploy_repair, llm_judge AND the project/
# skill agent runs all use the cloud brain. Fill in a YUNWU_* key:
HEYI_EVAL_JUDGE_PROVIDER=yunwu
YUNWU_BASE_URL=https://yunwu.ai/v1
YUNWU_GENERAL_KEY=
# Falls through to YUNWU_KEY_2 / YUNWU_GPT_KEY if YUNWU_GENERAL_KEY is empty.
# HEYI_EVAL_JUDGE_MODEL=MiniMax-M2.7        # overrides the per-provider default
# HEYI_EVAL_AGENT_MODEL=yunwu-m27,MiniMax-M2.7  # ccr Router spec for the agent route
#
# ── alternate provider: Zhipu GLM-5.1 (ready; needs a valid key) ─────────────
# Fully wired — flip the two lines below once a working Zhipu key exists:
#   HEYI_EVAL_JUDGE_PROVIDER=zhipu
#   ZHIPU_API_KEY=...
# (optional) ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4 ; ZHIPU_MODEL=glm-5.1
#
# ── alternate provider: local vLLM (:10814) ─────────────────────────────────
#   HEYI_EVAL_JUDGE_PROVIDER=local ; HEYI_ENGINE_URL=http://127.0.0.1:10814

# ── HF mirror ───────────────────────────────────────────────────────────────
# HF_ENDPOINT=https://hf-mirror.com

# ── orchestrator stage timeouts (seconds) ───────────────────────────────────
# HEYI_EVAL_DEPLOY_TIMEOUT=600
# HEYI_EVAL_CAPABILITY_TIMEOUT=900
# HEYI_EVAL_SHOWCASE_TIMEOUT=3600
# HEYI_EVAL_CLEANUP_TIMEOUT=300

# ── orchestrator main-loop pacing ───────────────────────────────────────────
# HEYI_HEARTBEAT_INTERVAL=14400          # 4h between desktop heartbeats
# HEYI_ENGINE_REMIND_INTERVAL=3600       # 1h between "still paused" reminders

# ── panel ───────────────────────────────────────────────────────────────────
# HEYI_PANEL_HOST=0.0.0.0
# HEYI_PANEL_PORT=8090
