#!/usr/bin/env bash
# /usr/local/sbin/heyi-eval-agent-audit-record — append-only audit
# write entrypoint for the sandboxed agent (PR#22b-M1, INV-21).
#
# Trust model
#   • Owned root:root 0755 so the agent can exec the script body and
#     hit the `EUID != 0` defensive check below; the actual write is
#     gated by `sudo` + the sudoers NOPASSWD whitelist (see
#     deploy/agent-sandbox/sudoers.d/heyi-eval-agent). Anything the
#     script reveals about itself by being readable is irrelevant —
#     it's published in the repo under the same name.
#   • This script is the ONE place that imports orchestrator.agent_audit
#     with write authority. The agent itself has no ACL on the audit
#     DB (INV-18) — so even if the agent compromises Python somehow,
#     it cannot bypass this wrapper to touch the DB.
#   • Subcommand whitelist (defense-in-depth over agent_audit.py CLI):
#     init | begin | end. Anything else is rejected with rc=2.
set -euo pipefail

PY="${HEYI_EVAL_PYTHON:-/home/ai/heyi-eval-v10/.venv/bin/python}"
REPO="${HEYI_EVAL_REPO:-/home/ai/heyi-eval-v10}"

# ── refuse to be invoked except as root ────────────────────────────
# When called via `sudo`, sudoers carries us to euid 0. If somehow
# we run as a non-root user, refuse — writing the audit DB as the
# agent itself would defeat INV-18.
if [[ $EUID -ne 0 ]]; then
  echo "heyi-eval-agent-audit-record: must run via sudo (got uid=$EUID)" >&2
  exit 2
fi

# ── subcommand whitelist ───────────────────────────────────────────
sub="${1:-}"
case "$sub" in
  init|begin|end) ;;
  *)
    echo "heyi-eval-agent-audit-record: denied subcommand ${sub@Q}; only init|begin|end allowed" >&2
    exit 2
    ;;
esac

# ── carry the invoking user/pid through to the audit row ───────────
# sudo sets SUDO_USER / SUDO_UID. We pass them as --invoking-user /
# --invoking-pid so the audit row records the ORIGINAL caller, not
# root. (The wrapper itself is just transport.)
invoker_user="${SUDO_USER:-unknown}"
invoker_pid="${SUDO_PID:-0}"

# init has no extra args; begin/end need the invoker passed through.
case "$sub" in
  init)
    shift
    exec "$PY" -m orchestrator.agent_audit init "$@"
    ;;
  begin|end)
    shift
    exec "$PY" -m orchestrator.agent_audit \
        "$sub" \
        --invoking-user "$invoker_user" \
        --invoking-pid  "$invoker_pid" \
        "$@"
    ;;
esac
