[Unit]
Description=heyi-eval-v10 HF model discovery tracker (loop mode)
Documentation=https://github.com/yoligehude14753/heyi-eval-v10/blob/main/docs/PR7b_TEST_PLAN.md
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=600s

[Service]
Type=simple
User=ai
Group=ai
WorkingDirectory=/home/ai/heyi-eval-v10
EnvironmentFile=-/etc/heyi-eval-v10/env
Environment=PYTHONUNBUFFERED=1
Environment=HF_ENDPOINT=https://hf-mirror.com
# `discover` is a package, must invoke the CLI module directly (PR#30 fix).
# PR#49 + PR#52: cursor-driven backfill-then-incremental.
#   --backfill-interval 1800 (30min) — one backfill round drains 2026
#                                      history in ~30min via cursor-paged
#                                      mirror_paginate_models; back off
#                                      so we don't double-load the hub
#   --interval 86400 (24h)          → after backfill, daily delta sweep
#   --mode auto                     → tracker decides based on cursor.backfill_complete
ExecStart=/home/ai/heyi-eval-v10/.venv/bin/python -m discover.main loop \
    --mode auto \
    --backfill-interval 1800 \
    --interval 86400 \
    --backfill-page-size 1000 \
    --backfill-page-sleep-s 0.2
Restart=on-failure
RestartSec=30s
# discover is HF-Hub-bound, lower priority than orchestrator main loop.
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=2G
MemoryMax=4G
TasksMax=256

[Install]
WantedBy=multi-user.target
