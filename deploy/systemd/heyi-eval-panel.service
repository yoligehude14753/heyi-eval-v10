[Unit]
Description=heyi-eval-v10 read-only management panel (HTTP)
Documentation=https://github.com/yoligehude14753/heyi-eval-v10/blob/main/docs/ARCHITECTURE.md
After=network-online.target
Wants=network-online.target
StartLimitBurst=10
StartLimitIntervalSec=300s

[Service]
Type=simple
User=ai
Group=ai
WorkingDirectory=/home/ai/heyi-eval-v10
EnvironmentFile=-/etc/heyi-eval-v10/env
ExecStart=/home/ai/heyi-eval-v10/.venv/bin/python -m panel
Restart=on-failure
RestartSec=5s
# Panel is light; default nice. Still want to yield to heyi_engine on shared host.
Nice=5
MemoryHigh=512M
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
