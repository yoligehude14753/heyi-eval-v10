{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heyi-eval.local/schemas/ready.schema.json",
  "title": "DEPLOY stage artifact (ready.json)",
  "type": "object",
  "required": ["stage", "run_id", "hf_id", "engine", "container_name", "endpoint", "served_model_name", "gpu_index"],
  "properties": {
    "stage": { "const": "DEPLOY" },
    "run_id": { "type": "string", "minLength": 1 },
    "hf_id": { "type": "string", "minLength": 1 },
    "engine": { "enum": ["vllm", "sglang", "transformers"] },
    "engine_image": { "type": "string" },
    "container_name": {
      "type": "string",
      "pattern": "^e9-",
      "description": "INV-1 (v10): must start with e9- prefix. v9 used e8- and required gpu_index pinning; v10 enforces isolation via labels + e9- name prefix instead."
    },
    "endpoint": { "type": "string", "format": "uri" },
    "served_model_name": { "type": "string" },
    "gpu_index": { "type": "integer", "minimum": 0, "maximum": 7,
                   "description": "Informational only in v10. Production GPU pinning is handled by the orchestrator's label-based filter, not by reserved index ranges (heyi_engine moved off the nv8 box in places — INV-1 v9 no longer applies)." },
    "boot_seconds": { "type": "number" },
    "started_at": { "type": "string" },
    "ready_at": { "type": "string" },
    "vllm_models_response": { "type": "object" },
    "error": { "type": "string" }
  },
  "additionalProperties": true
}
