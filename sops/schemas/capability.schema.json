{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heyi-eval.local/schemas/capability.schema.json",
  "title": "CAPABILITY stage artifact (capability.json) — PR#15 multimodal",
  "type": "object",
  "required": ["stage", "run_id", "hf_id", "results"],
  "properties": {
    "stage": { "const": "CAPABILITY" },
    "run_id": { "type": "string", "minLength": 1 },
    "hf_id": { "type": "string", "minLength": 1 },
    "base_url": { "type": "string" },
    "evaluated_at": { "type": "string" },
    "results": {
      "description": "Flat union of every applicable category's items (kept for backward compat with older panel + tests).",
      "type": "array",
      "items": { "$ref": "#/$defs/Item" }
    },
    "categories": {
      "description": "Per-category breakdown. Key is the category name from CATEGORY_REGISTRY.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/Category" }
    },
    "score": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
    "pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "total_duration_s": { "type": "number" },
    "aborted_due_to": { "type": "string" }
  },
  "$defs": {
    "Category": {
      "type": "object",
      "required": ["applicable", "scorer", "score", "pass_rate", "items"],
      "properties": {
        "applicable": { "type": "boolean" },
        "scorer": { "enum": ["substring", "output_validity", "llm_judge", "non_empty_output"] },
        "score": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
        "pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/Item" }
        },
        "reason": { "type": "string" },
        "aborted_due_to": { "type": "string" }
      },
      "additionalProperties": true
    },
    "Item": {
      "type": "object",
      "required": ["id", "prompt", "pass"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "prompt": { "type": "string", "minLength": 1 },
        "expected_substring": { "type": "string" },
        "expected_description": { "type": "string" },
        "fixture": { "type": "string" },
        "actual": { "type": ["string", "null"] },
        "pass": { "type": "boolean" },
        "latency_ms": { "type": "number" },
        "tokens_in": { "type": "number" },
        "tokens_out": { "type": "number" },
        "content_type": { "type": ["string", "null"] },
        "byte_count": { "type": "number" },
        "judge_pass": { "type": "boolean" },
        "judge_reason": { "type": "string" },
        "error": { "type": "string" },
        "finish_reason": { "type": "string" },
        "scorer_used": { "enum": ["substring", "output_validity", "llm_judge", "non_empty_output"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
