# Keep the transformers-runner build context tight. The image only
# needs transformers_runner/* + the top-level requirements.txt-like
# files. Everything else here would just slow `docker build` down
# without ever being COPYed in.

.git/
.venv/
venv/
*.pyc
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Run-time data and panel artifacts must never enter an image layer
runs/
panel-data/
_artifacts/

# IDE noise
.vscode/
.idea/
*.swp

# Project-level docs and tests aren't needed in the runtime image
docs/
tests/
e2e/
scripts/
sops/
backup/
deploy/
cc_agent/
curator/
discover/
orchestrator/
panel/
